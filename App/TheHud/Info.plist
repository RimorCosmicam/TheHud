<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- GENERATE_INFOPLIST_FILE is NO, so nothing here is synthesised. Without CFBundleIdentifier
	     and CFBundleExecutable the app cannot be installed or signed at all. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>TheHud</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- Without this iOS runs the app letterboxed at a legacy size, which would put the surface
	     somewhere other than half the display. An empty dictionary means a plain black screen,
	     which is what this app wants anyway. -->
	<key>UILaunchScreen</key>
	<dict/>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Phone</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).PhoneSceneDelegate</string>
				</dict>
			</array>
			<key>UIWindowSceneSessionRoleExternalDisplayNonInteractive</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Glasses</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).GlassesSceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>

	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Shows your day and your month on the glasses.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>The camera app saves the photos and videos you take to your library.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Shows your photos on the glasses, one at a time or as a gallery.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>The Mac panel finds HudCast on your Mac, and Remote Connect finds your Android phone, over the local network.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_thehud._tcp</string>
		<string>_thehud-remote._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>The camera app shows what the phone sees on the glasses, and Remote Connect scans the code on your Android phone to pair with it.</string>
	<!-- Remote Connect's QR code is a thehud:// link, so the Camera app can open it here too. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>thehud</string>
			</array>
		</dict>
	</array>
	<key>NSMotionUsageDescription</key>
	<string>The activity widget counts your steps, distance and floors today.</string>
	<key>NSAppleMusicUsageDescription</key>
	<string>The music widget shows what the Music app is playing and lets you play, pause and skip.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Captions listen to what is said around you and write it on the glasses, and the camera records sound with video.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Captions turn speech into text on the phone.</string>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- Locked in a pocket with the glasses on, location keeps the app running so the glasses
	     keep being drawn; audio keeps captions listening. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>audio</string>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Draws the minimap and fetches the weather where you are.</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
</dict>
</plist>
