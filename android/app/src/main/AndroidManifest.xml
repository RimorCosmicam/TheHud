<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:name=".HudApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.TheHud"
        android:hardwareAccelerated="true">

        <!-- The Flip's cover screen (FlexWindow): keep running there, and over the lock screen. -->
        <meta-data android:name="com.samsung.android.multidisplay.keep_process_alive" android:value="true" />
        <meta-data android:name="com.samsung.android.activity.showWhenLocked" android:value="true" />
        <meta-data android:name="com.samsung.android.coverscreen.subscreen_compatible" android:value="true" />

        <activity
            android:name=".CoverActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden|keyboard|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Good Lock / MultiStar's cover screen launcher. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.samsung.android.support.COVER_SCREEN" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.samsung.android.launcher.action.ENTER_COVER_SCREEN_APP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The glasses, when the phone runs DeX on them and will not take a presentation. -->
        <activity
            android:name=".glasses.GlassesActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density"
            android:theme="@style/Theme.TheHud" />
    </application>
</manifest>
